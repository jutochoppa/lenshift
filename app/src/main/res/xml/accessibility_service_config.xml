<?xml version="1.0" encoding="utf-8"?>
<!--
  Lenshift's accessibility fallback exists for exactly one purpose: the user taps the
  accessibility shortcut and Lenshift grabs a single screenshot with
  AccessibilityService.takeScreenshot().

  - eventTypes is empty: Lenshift never subscribes to accessibility events.
  - canRetrieveWindowContent="false": no window text, no node tree.
  - canTakeScreenshot is the only capability requested.
  - No gesture injection, no key filtering, no touch exploration.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/accessibility_service_description"
    android:accessibilityEventTypes=""
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canTakeScreenshot="true"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="100"
    android:settingsActivity="dev.lenshift.app.ui.MainActivity" />
